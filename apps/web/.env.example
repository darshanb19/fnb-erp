# F&B ERP — apps/web env example. Copy to .env.local and fill in.
# .env.local is gitignored; this file is committed (no secrets here).

# === API ===
# Base URL for the F&B ERP Express API (apps/api). Default port is 3001.
VITE_API_BASE_URL=http://localhost:3001

# === DL-029 dev-stub auth (will be replaced in Epic 2 USR) ===
# Shared HS256 secret — must match apps/api SUPABASE_JWT_SECRET.
# Default test secret when both are unset: 'test-secret-do-not-use-in-prod'
# (see apps/api/src/env.ts — NODE_ENV=test default).
VITE_DEV_JWT_SECRET=test-secret-do-not-use-in-prod

# Seed brand + user IDs. Get these from `pnpm --filter @fnberp/api db:seed`
# (the script prints `Created brand id=...`). The user id is hand-rolled —
# any valid UUID works for dev because Arc (a) treats users as a stub table.
VITE_SEED_BRAND_ID=00000000-0000-0000-0000-000000000000
VITE_SEED_USER_ID=00000000-0000-0000-0000-000000000001

# Optional — auto sign-in on app load using dev-stub auth.
# Set to 'true' to skip the dev-login button click every time Vite HMR reloads.
# Leave unset (or 'false') if you want explicit sign-in control.
VITE_AUTO_DEV_SIGNIN=true
