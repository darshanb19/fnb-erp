# F&B ERP — apps/web env example. Copy to .env.local and fill in.
# .env.local is gitignored; this file is committed (no secrets here).

# === API ===
# Base URL for the F&B ERP Express API (apps/api). Default port is 3001.
VITE_API_BASE_URL=http://localhost:3001

# === Supabase Auth (Mumbai project — DL-007 / DL-033) ===
# Project URL and anon (publishable) key. Get these from the Supabase
# dashboard → Settings → API. The anon key is safe to ship in the client;
# the JWT signing secret stays only in apps/api.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# === Bootstrap Brand Owner (dev-only seed account) ===
# Created by `pnpm --filter @fnberp/api bootstrap:bo` — that script prints the
# email + password to stdout. Used by the Playwright globalSetup to sign in
# once and reuse the storage state across all e2e specs. Not required for
# manual dev work — the real SI-USR-003 login page (Task C3) lets any user
# sign in with their own credentials.
VITE_BOOTSTRAP_BO_EMAIL=
VITE_BOOTSTRAP_BO_PASSWORD=
