{
  "name": "@fnberp/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "sh scripts/drizzle-kit-generate.sh",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "NODE_ENV=test tsx src/db/seed/brand-seed.ts",
    "bootstrap:bo": "tsx --env-file=.env scripts/bootstrap-supabase-bo.ts"
  },
  "dependencies": {
    "@fnberp/shared": "workspace:^",
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.36.0",
    "express": "^4.21.0",
    "jose": "^5.9.6",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "drizzle-kit": "^0.28.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
